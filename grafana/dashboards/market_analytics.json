        {
          "datasource": {
            "type": "postgres",
            "uid": "databricks"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    d.date AS time,\n    s.symbol,\n    AVG(f.close_price) AS avg_close_price\nFROM market_data.fact_market_data f\nJOIN market_data.dim_date d ON f.date_id = d.date_id\nJOIN market_data.dim_symbol s ON f.symbol_id = s.symbol_id\nWHERE d.date >= CURRENT_DATE - INTERVAL 30 DAYS\n  AND f.close_price IS NOT NULL\n  AND s.symbol = '$symbol'\nGROUP BY d.date, s.symbol\nORDER BY d.date;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Price Trends (Last 30 Days)",
      "type": "timeseries"
