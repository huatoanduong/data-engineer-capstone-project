          "rawQuery": true,
          "rawSql": "SELECT\n    s.symbol,\n    f.rsi,\n    f.timestamp\nFROM market_data.fact_market_data f\nJOIN market_data.dim_symbol s ON f.symbol_id = s.symbol_id\nWHERE f.timestamp >= CURRENT_TIMESTAMP - INTERVAL 1 DAY\n  AND f.rsi IS NOT NULL\n  AND s.symbol = '$symbol'\nORDER BY f.timestamp DESC;",
